<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        SidekitTextField's dictation needs RECORD_AUDIO, but a design library must not request it
        for every consumer. Apps that enable dictation declare it themselves; :app already does.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
